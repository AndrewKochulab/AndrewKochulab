exports[`registry and pipeline > matches snapshots for both themes and viewports 31`] = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 140" width="400" height="140" role="img" aria-label="Contributions · last 12 months"><title>Contributions · last 12 months</title><style>@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes pop{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes spin-reverse{to{transform:rotate(-360deg)}}
@keyframes pulse{0%,100%{opacity:.55}50%{opacity:1}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes draw{from{stroke-dashoffset:var(--len)}to{stroke-dashoffset:0}}
@keyframes sweep{0%{transform:translateX(var(--from))}55%,100%{transform:translateX(var(--to))}}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
@keyframes drift{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(var(--dx),var(--dy)) scale(1.08)}}
.a-rise{opacity:0;animation:rise 800ms cubic-bezier(0.16, 1, 0.3, 1) both}
.a-fade{opacity:0;animation:fade 800ms cubic-bezier(0.16, 1, 0.3, 1) both}
.a-pop{opacity:0;animation:pop 800ms cubic-bezier(0.16, 1, 0.3, 1) both;transform-box:fill-box;transform-origin:center}
.a-spin{animation:spin var(--orbit,24000ms) linear infinite;transform-box:view-box;transform-origin:0 0}
.a-spin-reverse{animation:spin-reverse var(--orbit,24000ms) linear infinite;transform-box:view-box;transform-origin:0 0}
.a-pulse{animation:pulse var(--period,7000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite}
.a-float{animation:float var(--period,7000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite}
.a-draw{stroke-dashoffset:var(--len);animation:draw var(--dur,1400ms) cubic-bezier(0.16, 1, 0.3, 1) both}
.a-sweep{animation:sweep var(--period,9000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite}
.a-blink{animation:blink 1s step-end infinite}
.a-drift{animation:drift var(--period,16000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite;transform-box:fill-box;transform-origin:center}
@media (prefers-reduced-motion:reduce){.a-rise,.a-fade,.a-pop{animation:none;opacity:1;transform:none}.a-draw{animation:none;stroke-dashoffset:0}.a-spin,.a-spin-reverse,.a-pulse,.a-float,.a-sweep,.a-blink,.a-drift{animation:none}}
@media (prefers-reduced-motion:reduce){.snake{display:none}}</style><defs><filter id="glow-soft" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="4" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter><filter id="glow-strong" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="10" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter><linearGradient id="frame-bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0a0a12"/><stop offset="1" stop-color="#10101a"/></linearGradient><linearGradient id="frame-highlight" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="rgba(255,255,255,0.22)" stop-opacity="0"/><stop offset="0.5" stop-color="rgba(255,255,255,0.22)"/><stop offset="1" stop-color="rgba(255,255,255,0.22)" stop-opacity="0"/></linearGradient><clipPath id="frame-clip"><rect width="400" height="140" rx="22"/></clipPath><radialGradient id="aurora-0"><stop offset="0" stop-color="#bf5af2" stop-opacity="0.16"/><stop offset="1" stop-color="#bf5af2" stop-opacity="0"/></radialGradient><radialGradient id="aurora-1"><stop offset="0" stop-color="#bf5af2" stop-opacity="0.16"/><stop offset="1" stop-color="#bf5af2" stop-opacity="0"/></radialGradient><radialGradient id="aurora-2"><stop offset="0" stop-color="#5ac8fa" stop-opacity="0.08"/><stop offset="1" stop-color="#5ac8fa" stop-opacity="0"/></radialGradient></defs><g clip-path="url(#frame-clip)"><rect width="400" height="140" fill="url(#frame-bg)"/><circle cx="40" cy="56" r="248" fill="url(#aurora-0)" class="a-drift" style="--dx:16px;--dy:14px;--period:18000ms;animation-delay:-0ms"/><circle cx="360" cy="84" r="248" fill="url(#aurora-1)" class="a-drift" style="--dx:-16px;--dy:-14px;--period:20000ms;animation-delay:-5000ms"/><circle cx="200" cy="7" r="180" fill="url(#aurora-2)" class="a-drift" style="--dx:20px;--dy:11.2px;--period:16000ms;animation-delay:-10000ms"/><rect x="