exports[`registry and pipeline > matches snapshots for both themes 18`] = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 163 66" width="163" height="66" role="img" aria-label="Instagram: https://www.instagram.com/andrewkochulab"><title>Instagram: https://www.instagram.com/andrewkochulab</title><style>@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes pop{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes spin-reverse{to{transform:rotate(-360deg)}}
@keyframes pulse{0%,100%{opacity:.55}50%{opacity:1}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes draw{from{stroke-dashoffset:var(--len)}to{stroke-dashoffset:0}}
@keyframes sweep{0%{transform:translateX(var(--from))}55%,100%{transform:translateX(var(--to))}}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
@keyframes drift{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(var(--dx),var(--dy)) scale(1.08)}}
.a-rise{opacity:0;animation:rise 800ms cubic-bezier(0.16, 1, 0.3, 1) both}
.a-fade{opacity:0;animation:fade 800ms cubic-bezier(0.16, 1, 0.3, 1) both}
.a-pop{opacity:0;animation:pop 800ms cubic-bezier(0.16, 1, 0.3, 1) both;transform-box:fill-box;transform-origin:center}
.a-spin{animation:spin var(--orbit,24000ms) linear infinite;transform-box:view-box;transform-origin:0 0}
.a-spin-reverse{animation:spin-reverse var(--orbit,24000ms) linear infinite;transform-box:view-box;transform-origin:0 0}
.a-pulse{animation:pulse var(--period,7000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite}
.a-float{animation:float var(--period,7000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite}
.a-draw{stroke-dashoffset:var(--len);animation:draw var(--dur,1400ms) cubic-bezier(0.16, 1, 0.3, 1) both}
.a-sweep{animation:sweep var(--period,9000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite}
.a-blink{animation:blink 1s step-end infinite}
.a-drift{animation:drift var(--period,16000ms) cubic-bezier(0.45, 0, 0.55, 1) infinite;transform-box:fill-box;transform-origin:center}
@media (prefers-reduced-motion:reduce){.a-rise,.a-fade,.a-pop{animation:none;opacity:1;transform:none}.a-draw{animation:none;stroke-dashoffset:0}.a-spin,.a-spin-reverse,.a-pulse,.a-float,.a-sweep,.a-blink,.a-drift{animation:none}}</style><defs><linearGradient id="brand-instagram" x1="0.146" y1="0.854" x2="0.854" y2="0.146"><stop offset="0" stop-color="#f9ce34"/><stop offset="0.5" stop-color="#ee2a7b"/><stop offset="1" stop-color="#6228d7"/></linearGradient><linearGradient id="sheen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff" stop-opacity="0.28"/><stop offset="0.5" stop-color="#ffffff" stop-opacity="0.04"/><stop offset="1" stop-color="#ffffff" stop-opacity="0"/></linearGradient><filter id="shadow" x="-20%" y="-40%" width="140%" height="200%"><feGaussianBlur stdDeviation="5"/></filter><clipPath id="button-clip"><rect width="143" height="46" rx="23"/></clipPath></defs><g transform="translate(10 10)"><g class="a-pop" style="animation-delay:80ms"><rect width="143" height="46" rx="23" y="4" fill="#ee2a7b" opacity="0.35" filter="url(#shadow)"/><rect width="143" height="46" rx="23" fill="url(#brand-instagram)"/><rect width="143" height="46" rx="23" fill="url(#sheen)"/><rect x="0.5" y="0.5" width="142" height="45" rx="22.5" fill="none" stroke="#ffffff" stroke-opacity="0.25"/><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.